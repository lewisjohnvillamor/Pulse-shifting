# PulseShift configuration. Copy to `.env` (gitignored) to override.
# No secrets live here: market data comes from Binance public endpoints and
# needs no credentials. Bring-your-own AI provider keys are entered in the
# app's settings gear and stored in data/config.json (also gitignored).

# --- Python API (app/settings.py) ---
PULSESHIFT_HOST=127.0.0.1
PULSESHIFT_PORT=8000
# Comma-separated origins allowed to call the API (the dev UI by default).
PULSESHIFT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Where watchlist, paper account, forward records and research caches go.
PULSESHIFT_DATA_DIR=./data

# --- Web UI (web/vite.config.ts reads this same file) ---
VITE_API_URL=http://127.0.0.1:8000
VITE_HOST=127.0.0.1
VITE_PORT=5173

# --- Optional local model adapters ---
# Laya adapter endpoint (strategies/laya.py); abstains when unreachable.
LAYA_URL=http://127.0.0.1:8791/decide
